---
// Adds the page's availability status under every documentation title.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { markdownPath } from '../../data/markdown.ts';
import StatusPill from '../StatusPill.astro';

const { entry } = Astro.locals.starlightRoute;
const { status, plan } = entry.data;
const markdown = entry.id.startsWith('docs') ? markdownPath(entry.id) : undefined;
---
<Default />
<div class="page-meta">
  <p class="page-status"><StatusPill status={status} plan={plan} /></p>
  {markdown && (
    <p class="page-actions">
      <button type="button" data-copy-markdown={markdown}>Copy page as Markdown</button>
      <a href={markdown}>View as Markdown</a>
    </p>
  )}
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]')) {
    button.addEventListener('click', async () => {
      const label = button.textContent;
      try {
        const markdown = await (await fetch(button.dataset.copyMarkdown!)).text();
        await navigator.clipboard.writeText(markdown);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed — use View as Markdown';
      }
      setTimeout(() => { button.textContent = label; }, 2000);
    });
  }
</script>

<style>
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
  }

  .page-meta p {
    margin: 0;
  }

  .page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--sl-text-sm);
  }

  .page-actions button {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }

  .page-actions button:hover {
    border-color: var(--sl-color-accent);
  }

  .page-actions a {
    color: var(--sl-color-accent);
  }
</style>
