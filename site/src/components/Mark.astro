---
// The table mark, drawn with theme tokens so it follows the selected theme.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <circle cx="16" cy="16" r="14" stroke="var(--line-strong)" stroke-width="1.2" stroke-dasharray="1.5 3" />
  <rect x="9.5" y="9" width="13" height="14" rx="5.5" fill="var(--surface-3)" stroke="var(--line-strong)" stroke-width="1.2" />
  <circle cx="16" cy="4.6" r="2.1" fill="var(--text)" />
  <circle cx="4.6" cy="16" r="2.1" fill="var(--text)" />
  <circle cx="27.4" cy="16" r="2.1" fill="var(--text)" />
  <circle cx="16" cy="27.4" r="2.6" fill="var(--accent)" />
</svg>
