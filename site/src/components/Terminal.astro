---
// Renders captured terminal text verbatim. Styling only wraps known patterns
// in spans; it never adds, removes or rewrites a character of the capture.
interface Props { title: string; screen: string; label: string; replay?: boolean }
const { title, screen, label, replay = false } = Astro.props;

type Part = { text: string; tone?: 'strong' | 'dim' | 'tag' | 'accent' | 'APPROVED' | 'REJECTED' | 'INSUFFICIENT_EVIDENCE' };

function partsOf(line: string): Part[] {
  const header = /^(BOARDROOM)( \| .*)$/.exec(line);
  if (header) return [{ text: header[1]!, tone: 'strong' }, { text: header[2]!, tone: 'dim' }];
  const speaker = /^(\[[a-z-]+\])( )([^|]+)( \| .*)$/.exec(line);
  if (speaker) return [{ text: speaker[1]!, tone: 'tag' }, { text: speaker[2]! }, { text: speaker[3]!, tone: 'strong' }, { text: speaker[4]!, tone: 'dim' }];
  if (line.startsWith('Evidence: ')) return [{ text: line, tone: 'accent' }];
  return line.split(/(APPROVED|REJECTED|INSUFFICIENT_EVIDENCE)/).filter(Boolean).map(text =>
    text === 'APPROVED' || text === 'REJECTED' || text === 'INSUFFICIENT_EVIDENCE' ? { text, tone: text } : { text });
}

// Blocks are separated by blank lines: the header, then one block per intervention.
// Each blank separator stays inside its block, so the rendered text is unchanged.
const blocks: Part[][][] = [[]];
for (const line of screen.split(/\r?\n/)) {
  blocks.at(-1)!.push(partsOf(line));
  if (line === '') blocks.push([]);
}
const id = `terminal-${Math.abs([...title].reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) | 0, 7))}`;
---
<div class="terminal" data-replay={replay ? '' : undefined}>
  <div class="chrome">
    <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title" aria-hidden="true">{title}</span>
    {replay
      ? <button class="replay" type="button" aria-controls={id} data-replay-toggle hidden>Replay the meeting</button>
      : <span class="spacer" aria-hidden="true"></span>}
  </div>
  <pre id={id} tabindex="0" aria-label={label}><code>{blocks.map((block, index) => (
    <span class="block" data-block data-index={index}>{block.map(parts => <span class="line">{parts.map(part => part.tone ? <span class={`t-${part.tone}`}>{part.text}</span> : part.text)}{'\n'}</span>)}</span>
  ))}</code></pre>
  {replay && <p class="replay-status" role="status"></p>}
</div>

<script>
  // Replays the capture one intervention at a time, as `boardroom demo --next` reads it.
  // Without JavaScript, the whole capture stays visible and the button stays hidden.
  const STEP_MS = 1100;
  for (const terminal of document.querySelectorAll<HTMLElement>('[data-replay]')) {
    const button = terminal.querySelector<HTMLButtonElement>('[data-replay-toggle]')!;
    const status = terminal.querySelector<HTMLElement>('[role="status"]')!;
    const blocks = [...terminal.querySelectorAll<HTMLElement>('[data-block]')];
    const total = blocks.length - 1;
    let shown = blocks.length;
    let timer: number | undefined;

    const render = () => {
      blocks.forEach((block, index) => {
        const visible = index <= shown;
        if (visible && block.hidden) block.classList.add('enter');
        block.hidden = !visible;
      });
      const complete = shown >= total;
      status.textContent = complete ? `Intervention ${total} of ${total} — recording complete` : `Intervention ${shown} of ${total}`;
      button.textContent = complete ? 'Replay the meeting' : 'Show the whole capture';
      if (complete) window.clearInterval(timer);
    };

    button.hidden = false;
    button.addEventListener('click', () => {
      window.clearInterval(timer);
      if (shown < total) {
        shown = total;
      } else {
        shown = 1;
        timer = window.setInterval(() => { shown += 1; render(); }, STEP_MS);
      }
      render();
    });
  }
</script>

<style>
  .terminal {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--term-bg);
    box-shadow: var(--shadow-raised);
  }

  .chrome {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid rgb(120 147 141 / 0.2);
  }

  .spacer {
    width: 3.25rem;
  }

  .replay {
    padding: 0.3rem 0.8rem;
    border: 1px solid rgb(216 238 174 / 0.5);
    border-radius: var(--radius-pill);
    background: transparent;
    color: #d8eeae;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background-color var(--duration) var(--ease-out);
  }

  .replay:hover {
    background: rgb(216 238 174 / 0.12);
  }

  .replay-status {
    min-height: 2.6rem;
    padding: 0 var(--space-5) var(--space-4);
    color: var(--term-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .block.enter {
    animation: reveal 320ms var(--ease-out);
  }

  @keyframes reveal {
    from {
      opacity: 0;
    }
  }

  .lights {
    display: flex;
    gap: 0.4rem;
  }

  .lights i {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: rgb(196 211 214 / 0.18);
  }

  .title {
    overflow: hidden;
    color: var(--term-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  pre {
    overflow-x: auto;
    padding: var(--space-5);
    color: var(--term-text);
    font-size: clamp(0.62rem, 0.5rem + 0.42vw, 0.84rem);
    line-height: 1.6;
    scrollbar-color: rgb(120 147 141 / 0.4) transparent;
  }

  .t-strong {
    color: #f5f4ec;
    font-weight: 600;
  }

  .t-dim {
    color: var(--term-dim);
  }

  .t-tag,
  .t-accent {
    color: #d8eeae;
  }

  .t-APPROVED {
    color: #a9d88f;
  }

  .t-REJECTED {
    color: #f5a898;
  }

  .t-INSUFFICIENT_EVIDENCE {
    color: #f2cb72;
  }
</style>
