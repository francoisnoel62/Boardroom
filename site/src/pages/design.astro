---
import Claim from '../components/Claim.astro';
import EvidenceQuote from '../components/EvidenceQuote.astro';
import Paper from '../components/Paper.astro';
import Seat from '../components/Seat.astro';
import StatusPill from '../components/StatusPill.astro';
import Terminal from '../components/Terminal.astro';
import Verdict from '../components/Verdict.astro';
import { story } from '../data/demo.ts';
import Site from '../layouts/Site.astro';

const colors = [
  ['--surface-0', 'Page'], ['--surface-1', 'Section'], ['--surface-2', 'Card'], ['--surface-3', 'Table'],
  ['--text-strong', 'Headings'], ['--text', 'Body'], ['--text-muted', 'Secondary'], ['--accent', 'Signal'],
  ['--approved', 'Approved'], ['--rejected', 'Rejected'], ['--insufficient', 'Insufficient evidence'], ['--line-strong', 'Line'],
];
const staffing = story.steps.find(step => step.evidence)!;
const sample = `BOARDROOM | Recorded example — scripted fictional fixture; no model calls.

[objection] Lead Developer | Fictional model B — scripted fixture
Two engineers cannot credibly deliver that scope in four weeks.
Evidence: context.md:4-4

Final views on v2: Product Owner APPROVED; Marketing Manager INSUFFICIENT_EVIDENCE.`;
---
<Site title="Design system — Boardroom" description="Tokens, typography and components of the BOARDROOM website and documentation." noindex>
  <section class="section first" aria-labelledby="design-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Design system</p>
        <h1 id="design-title" class="display">The room at night</h1>
        <p>
          Calm surfaces, paper records and a single signal colour, derived from the original Boardroom illustration.
          Every text pair meets WCAG 2.2 AA in both themes.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="colors-title">
    <div class="container">
      <h2 id="colors-title" class="title">Colour tokens</h2>
      <ul class="swatches">
        {colors.map(([token, name]) => (
          <li>
            <span class="swatch" style={`background: var(${token})`}></span>
            <span class="name">{name}</span>
            <code class="mono-label">{token}</code>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="type-title">
    <div class="container type">
      <h2 id="type-title" class="title">Typography</h2>
      <p class="display sample-display">Great decisions deserve a room.</p>
      <p class="mono-label">Display — Instrument Serif · OFL · self-hosted, preloaded</p>
      <p class="sample-text">Bring your toughest question to a team of AI advisers. You make the call.</p>
      <p class="mono-label">Text — Inter · OFL · self-hosted on the site; system font in the docs</p>
      <p class="sample-mono">boardroom export --output ./exports</p>
      <p class="mono-label">Code — system monospace (SF Mono, Cascadia Mono or Consolas, DejaVu Sans Mono)</p>
    </div>
  </section>

  <section class="section" aria-labelledby="components-title">
    <div class="container components">
      <h2 id="components-title" class="title">Components</h2>

      <div class="row">
        <h3>Buttons</h3>
        <div class="items">
          <a class="button button--primary" href="/docs/quickstart/">Primary action</a>
          <a class="button button--ghost" href="/docs/">Secondary action</a>
        </div>
      </div>

      <div class="row">
        <h3>Status</h3>
        <div class="items">
          <StatusPill status="available" />
          <StatusPill status="preview" />
          <StatusPill status="planned" plan="02" />
          <StatusPill status="vision" />
        </div>
      </div>

      <div class="row">
        <h3>Verdicts</h3>
        <div class="items">
          <Verdict verdict="APPROVED" />
          <Verdict verdict="REJECTED" />
          <Verdict verdict="INSUFFICIENT_EVIDENCE" />
        </div>
      </div>

      <div class="row">
        <h3>Seats</h3>
        <div class="items">
          <Seat role="Lead Developer" model="Fictional model B — scripted fixture" />
          <Seat role="You, the CEO" />
        </div>
      </div>

      <div class="row">
        <h3>Evidence</h3>
        <div class="items wide">
          {staffing.evidence && <EvidenceQuote evidence={staffing.evidence} />}
        </div>
      </div>

      <div class="row">
        <h3>Claim</h3>
        <div class="items wide">
          <Claim id="exact-citations" showEvidence />
        </div>
      </div>

      <div class="row">
        <h3>Terminal</h3>
        <div class="items wide">
          <Terminal title="Excerpt of the recorded example" screen={sample} label="Terminal component sample" />
        </div>
      </div>

      <div class="row">
        <h3>Paper</h3>
        <div class="items wide">
          <Paper name="memo.md" markdown={'# Decision memo\n\nHuman decision: pending. Adviser views do not decide for the human.'} />
        </div>
      </div>
    </div>
  </section>
</Site>

<style>
  .first {
    border-top: 0;
  }

  h1 {
    font-size: var(--step-4);
  }

  .title {
    margin-bottom: var(--space-6);
    font-size: var(--step-2);
    font-weight: 600;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: grid;
    gap: var(--space-1);
  }

  .swatch {
    height: 4.5rem;
    margin-bottom: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .name {
    color: var(--text-strong);
    font-weight: 600;
  }

  .type {
    display: grid;
    gap: var(--space-2);
  }

  .sample-display {
    color: var(--text-strong);
    font-size: var(--step-3);
  }

  .sample-text {
    margin-top: var(--space-5);
    color: var(--text-strong);
    font-size: var(--step-1);
  }

  .sample-mono {
    margin-top: var(--space-5);
    color: var(--text-strong);
    font-family: var(--font-mono);
  }

  .components {
    display: grid;
    gap: var(--space-6);
  }

  .row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .row h3 {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .items.wide {
    display: block;
    max-width: 44rem;
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
