---
import Architecture from '../components/Architecture.astro';
import RepoStats from '../components/RepoStats.astro';
import { decisions, limits } from '../data/engineering.ts';
import { repository, sourceUrl } from '../data/labels.ts';
import Site from '../layouts/Site.astro';

const evidenceName = (path: string) => path.split('/').at(-1);
---
<Site
  title="How Boardroom is built — Boardroom"
  description="The engineering decisions behind BOARDROOM, their tradeoffs, the evidence for each, and what is not proven yet."
>
  <section class="intro" aria-labelledby="engineering-title">
    <div class="container">
      <p class="eyebrow">Engineering</p>
      <h1 id="engineering-title" class="display">How Boardroom is built</h1>
      <p class="lede">
        A decision tool has to be trustworthy before it is clever. This page is for engineers and reviewers: the choices
        behind the current build, what each one costs, and where to check it in the repository.
      </p>
      <RepoStats />
      <Architecture />
    </div>
  </section>

  <section class="section" aria-labelledby="decisions-title">
    <div class="container">
      <div class="section-heading">
        <h2 id="decisions-title" class="display">Decisions and their tradeoffs</h2>
        <p>Every choice below links to the document or test that shows it.</p>
      </div>
      <ol class="decisions">
        {decisions.map((decision, index) => (
          <li class="decision" data-decision>
            <span class="mono-label">{String(index + 1).padStart(2, '0')}</span>
            <h3>{decision.title}</h3>
            <p>{decision.text}</p>
            <p class="tradeoff"><span>Tradeoff</span> {decision.tradeoff}</p>
            <p class="evidence">
              {decision.evidence.map((path, position) => (
                <>
                  {position > 0 && ' · '}
                  <a href={sourceUrl(path)} rel="noopener">Evidence: {evidenceName(path)}</a>
                </>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="limits-title">
    <div class="container limits-grid">
      <div class="section-heading">
        <h2 id="limits-title" class="display">What is not proven yet</h2>
        <p>
          Plan 01 was accepted with reservations. They are listed here as plainly as the achievements, from the same
          acceptance record.
        </p>
      </div>
      <ul class="limits">
        {limits.map(limit => (
          <li>
            <h3>{limit.title}</h3>
            <p>{limit.text}</p>
            <a href={sourceUrl(limit.evidence[0]!)} rel="noopener">Source: {evidenceName(limit.evidence[0]!)}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section closing" aria-labelledby="engineering-closing">
    <div class="container closing-inner">
      <h2 id="engineering-closing" class="display">Read the code, run the tests.</h2>
      <p>Everything on this page can be checked from a fresh clone.</p>
      <div class="ctas">
        <a class="button button--primary" href="/docs/quickstart/">Explore the recorded example</a>
        <a class="button button--ghost" href={repository} rel="noopener">Source on GitHub</a>
      </div>
    </div>
  </section>
</Site>

<style>
  .intro {
    padding-block: var(--space-8);
    background: var(--glow);
  }

  .intro .container {
    display: grid;
    gap: var(--space-5);
  }

  h1 {
    font-size: var(--step-4);
  }

  .lede {
    max-width: 44rem;
    margin-bottom: var(--space-4);
    font-size: var(--step-1);
  }

  .decisions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .decision {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }

  .decision h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.1;
  }

  .tradeoff {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--insufficient);
    background: color-mix(in srgb, var(--insufficient) 8%, transparent);
    color: var(--text);
    font-size: var(--step--1);
  }

  .tradeoff span {
    color: var(--text-strong);
    font-weight: 600;
  }

  .evidence a,
  .limits a {
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .evidence a:hover,
  .limits a:hover {
    text-decoration: underline;
  }

  .limits-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .limits {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .limits li {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-m);
  }

  .limits h3 {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .closing {
    background: var(--glow);
    text-align: center;
  }

  .closing-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
  }

  .closing h2 {
    font-size: var(--step-3);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  @media (max-width: 62rem) {
    .decisions,
    .limits-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
