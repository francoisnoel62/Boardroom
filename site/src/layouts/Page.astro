---
// Layout for the project's secondary pages: an introduction, then readable prose and panels.
import Site from './Site.astro';

interface Props { title: string; description: string; eyebrow: string; heading: string; lede: string; wide?: boolean }
const { title, description, eyebrow, heading, lede, wide = false } = Astro.props;
---
<Site title={title} description={description}>
  <section class="intro" aria-labelledby="page-title">
    <div class:list={['container', 'column', { wide }]}>
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="page-title" class="display">{heading}</h1>
      <p class="lede">{lede}</p>
    </div>
  </section>
  <div class:list={['container', 'column', 'page-body', { wide }]}>
    <slot />
  </div>
</Site>

<style>
  .intro {
    padding-block: var(--space-8) var(--space-6);
    background: var(--glow);
  }

  .column {
    max-width: 52rem;
  }

  .column.wide {
    max-width: var(--container);
  }

  .intro .column {
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--step-4);
  }

  .lede {
    max-width: 46rem;
    font-size: var(--step-1);
  }

  .page-body {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-6) var(--space-9);
  }

  .page-body :global(section) {
    display: grid;
    gap: var(--space-4);
  }

  .page-body :global(section > h2),
  .page-body :global(.panel > h2) {
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .page-body :global(h3) {
    color: var(--text-strong);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .page-body :global(p),
  .page-body :global(li) {
    max-width: 46rem;
  }

  .page-body :global(ul:not([class])),
  .page-body :global(ol:not([class])) {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1rem;
  }

  .page-body :global(a:not(.button, .plain)) {
    color: var(--accent);
    font-weight: 600;
  }

  .page-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    overflow-wrap: anywhere;
  }

  .page-body :global(.panel) {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }

  .page-body :global(.ctas) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 34rem) {
    .page-body :global(.panel) {
      padding: var(--space-5);
    }
  }
</style>
