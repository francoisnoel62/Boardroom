{
  "name": "boardroom-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The BOARDROOM website and public documentation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:build": "node --test tests/build/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:build && npm run test:e2e",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "astro": "7.3.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
