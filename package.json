{
  "name": "boardroom",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "description": "A local decision workspace for a human and three AI advisers.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.ts",
    "start": "node dist/cli.js",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "better-sqlite3": "12.10.0",
    "ink": "7.1.1",
    "react": "19.2.4",
    "zod": "4.3.6"
  }
}
